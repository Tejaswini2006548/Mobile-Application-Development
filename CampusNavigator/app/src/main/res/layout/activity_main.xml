
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="#2864AD"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:text="Campus Navigator"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp"
            android:text="Explore Campus Services"
            android:textColor="#263B5A"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWebsite"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#DCEBFA"
            android:text="University Website"
            android:textAllCaps="false"
            android:textColor="#173D69"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#DCEBFA"
            android:text="View Campus Map"
            android:textAllCaps="false"
            android:textColor="#173D69"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#DCEBFA"
            android:text="Call Office"
            android:textAllCaps="false"
            android:textColor="#173D69"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#DCEBFA"
            android:text="Share Campus Info"
            android:textAllCaps="false"
            android:textColor="#173D69"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="22dp"
            android:backgroundTint="#DCEBFA"
            android:text="About Campus"
            android:textAllCaps="false"
            android:textColor="#173D69"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="Select a service"
            android:textColor="#52647A"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
